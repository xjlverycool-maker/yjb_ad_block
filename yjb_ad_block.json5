{
  id: 10086,
  name: '养基宝广告拦截与自动跳转防护',
  version: 2,
  author: 'Gemini',
  checkUpdateUrl: '',
  supportUri: '',
  categories: [
    { key: 0, name: '开屏广告', enable: true },
    { key: 6, name: '局部广告', enable: true },
    { key: 7, name: '全屏广告', enable: true }
  ],
  apps: [
    {
      id: 'com.yangjibao.app', // 养基宝包名（如有差异可在GKD悬浮窗核对后调整）
      name: '养基宝',
      groups: [
        {
          key: 0,
          name: '开屏广告',
          desc: '自动点击右上角或全屏页面的跳过按钮',
          fastQuery: true,
          matchTime: 10000,
          actionMaximum: 1,
          resetMatch: 'app',
          rules: [
            {
              key: 0,
              name: '右上角倒计时跳过',
              matches: '[text*="跳过" && text$="秒" || text^="跳过" && text.length < 6][visibleToUser=true]',
              snapshotUrls: []
            },
            {
              key: 1,
              name: '通用跳过文本匹配',
              matches: '[text*="跳过" || text*="skip"][text.length < 10][visibleToUser=true]',
              snapshotUrls: []
            }
          ]
        },
        {
          key: 1,
          name: '全屏与信息流广告拦截',
          desc: '关闭全屏弹窗广告、信息流卡片广告，并拦截自动跳转',
          fastQuery: true,
          rules: [
            {
              key: 0,
              name: '关闭弹窗及信息流广告',
              matches: '@ImageView[clickable=true] - [text*="广告" || text*="查看详情"]',
              snapshotUrls: []
            },
            {
              key: 1,
              name: '外部跳转防护（防自动调起美团/饿了么等）',
              activityIds: ['com.sankuai.meituan', 'me.ele'],
              action: 'back',
              matches: '[text="正在打开美团" || text="正在打开饿了么" || text*="跳转到"]',
              snapshotUrls: []
            }
          ]
        }
      ]
    }
  ]
}